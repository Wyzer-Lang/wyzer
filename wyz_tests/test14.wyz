// test: graph with edges added at run time
// status: pending (depends on: nodes-never-move)
// expect: accept
//
// Edges are shared between nodes, so they are ~. Graph owns the nodes.
// If a Vec can move its items when it grows, every edge goes stale.

struct Node {
    id: Int;
    edges: Vec<~Node>;
}

struct Graph {
    nodes: Vec<Node>;
}

fn connect(a: Node!, b: ~Node) {
    a.edges.push(b);
}

fn main() {
    let g = Graph.new();
    g.nodes.push(Node.new(1));
    g.nodes.push(Node.new(2));
    connect(g.nodes[0], g.nodes[1]);
}
