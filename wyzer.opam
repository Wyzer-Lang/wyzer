opam-version: "2.0"
synopsis: "The Wyzer Programming Language Compiler"
description:
  "Wyzer is a statically typed, compiled, resource-oriented programming language with integrated distributed safety via choreographic programming and a perceus memory model."
maintainer: ["Atiksh Sharma"]
authors: ["Atiksh Sharma"]
license: "MIT"
homepage: "https://github.com/Wyzer-Lang/wyzer"
bug-reports: "https://github.com/Wyzer-Lang/wyzer/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.10" & >= "3.10"}
  "llvm" {>= "14.0"}
  "ppx_deriving" {>= "5.2.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Wyzer-Lang/wyzer.git"
