struct Point {
    x: u32,
    y: u32
}

fn main() {
    var p: Point = Point { x: 10, y: 20 };
    
    std::io::print("p.x = ");
    std::io::println(p.x);

    var i: u32 = 0;
    while i < 3 {
        std::io::println(i);
        i = i + 1;
    }

    let r: Result<u32, str> = Ok(42);
    match (r) {
        Ok(v) => std::io::println(v),
        Err(e) => std::io::println(999)
    };

    let r2: Result<u32, str> = Err("error");
    match (r2) {
        Ok(v) => std::io::println(v),
        Err(_) => std::io::println(0)
    };

    for item in 0 {
        std::io::println(888);
    }
}
