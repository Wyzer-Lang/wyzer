fn main() {
    let x: f64 = 3.14;
    let y: f32 = 2.0;
    let sum = x + y;
    std::io::println(sum);

    let pi: f64 = 3.14159;
    let r: f64 = 5.0;
    let area = pi * r;
    std::io::println(area);

    let s = std::math::sin(1.5707963);
    std::io::println(s);

    let cast_test = 42 as f64;
    std::io::println(cast_test);
}
