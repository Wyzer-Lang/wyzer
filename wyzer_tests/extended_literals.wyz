// extended_literals.wyz
// Tests for hexadecimal (0x...) and binary (0b...) integer literals.
//
// Malformed literals such as `0xG12` are not valid Wyzer source.
// The lexer will tokenise `0` as INT(0) then hand `xG12` to the IDENT
// rule, causing a parser error ("unexpected token") at the point where
// an operator or semicolon is expected.  That error path is exercised
// by the compiler's own diagnostic engine and is not tested here at
// runtime; see the comment at the bottom for the expected output.

fn main() {
    // ---------------------------------------------------------------
    // 1. Hex literals with explicit type suffixes
    // ---------------------------------------------------------------
    let byte_max: u8  = 0xFF;          // 255
    let short_val: u16 = 0x00FF;       // 255
    let dead_beef: u32 = 0xDEADBEEF;  // 3735928559
    let big_hex: u64  = 0xCAFEBABE;   // 3405691582

    std::io::println(byte_max);
    std::io::println(short_val);
    std::io::println(dead_beef);
    std::io::println(big_hex);

    // ---------------------------------------------------------------
    // 2. Binary literals with explicit type suffixes
    // ---------------------------------------------------------------
    let nibble: u8  = 0b1010;          // 10
    let byte_b: u8  = 0b11111111;      // 255
    let word_b: u16 = 0b1111000011110000; // 61680

    std::io::println(nibble);
    std::io::println(byte_b);
    std::io::println(word_b);

    // ---------------------------------------------------------------
    // 3. Unsuffixed hex/binary — type inferred from annotation
    //    (exercises the same fallback path as unsuffixed_int.wyz)
    // ---------------------------------------------------------------
    let inferred_hex: u32 = 0xFF;         // 255
    let inferred_bin: u32 = 0b1010;       // 10
    let inferred_i32       = 0xFF;        // defaults to i32 (255)

    std::io::println(inferred_hex);
    std::io::println(inferred_bin);
    std::io::println(inferred_i32);

    // ---------------------------------------------------------------
    // 4. Hex / binary in arithmetic expressions
    // ---------------------------------------------------------------
    let sum: u32  = 0xFF + 0b1010;       // 255 + 10 = 265
    let diff: u32 = 0xFF - 0b1111; // 255 - 15 = 240
    let prod: u32 = 0x10 * 0b11;   // 16 * 3  = 48

    std::io::println(sum);
    std::io::println(diff);
    std::io::println(prod);

    // ---------------------------------------------------------------
    // 5. Bitwise operations (natural home for hex/binary)
    // ---------------------------------------------------------------
    let and_result: u32 = 0xFF00 & 0x0FFF;  // 0x0F00 = 3840
    let or_result:  u32 = 0xFF00 | 0x00FF;  // 0xFFFF = 65535
    let shl_result: u32 = 0b0001 << 4;          // 16
    let shr_result: u32 = 0x80 >> 3;            // 16

    std::io::println(and_result);
    std::io::println(or_result);
    std::io::println(shl_result);
    std::io::println(shr_result);

    // ---------------------------------------------------------------
    // 6. Hex / binary in match patterns
    // ---------------------------------------------------------------
    let status: u32 = 0xFF;
    match (status) {
        0x00 => std::io::println(0),
        0xFF => std::io::println(255),
        _    => std::io::println(1)
    };

    let flags: u8 = 0b1010;
    match (flags) {
        0b0000 => std::io::println(0),
        0b1010 => std::io::println(10),
        _      => std::io::println(99)
    };

    // ---------------------------------------------------------------
    // 7. Unary negation applied to hex / binary (signed contexts)
    // ---------------------------------------------------------------
    let neg_hex: i32 = -0x01;   // -1
    let neg_bin: i32 = -0b0001; // -1

    std::io::println(neg_hex);
    std::io::println(neg_bin);

    // ---------------------------------------------------------------
    // 8. f-string interpolation of hex-/binary-valued variables
    // ---------------------------------------------------------------
    let port: u32 = 0x1F90;  // 8080
    std::io::println(f"Port number: {port}");

    // ---------------------------------------------------------------
    // Expected output (in order):
    //   255       (byte_max)
    //   255       (short_val)
    //   3735928559 (dead_beef)
    //   3405691582 (big_hex)
    //   10        (nibble)
    //   255       (byte_b)
    //   61680     (word_b)
    //   255       (inferred_hex)
    //   10        (inferred_bin)
    //   255       (inferred_i32)
    //   265       (sum)
    //   240       (diff)
    //   48        (prod)
    //   3840      (and_result)
    //   65535     (or_result)
    //   16        (shl_result)
    //   16        (shr_result)
    //   255       (match hex)
    //   10        (match bin)
    //   -1        (neg_hex)
    //   -1        (neg_bin)
    //   Port number: 8080
    //
    // Malformed literal error example (should NOT be added to this file):
    //   let bad = 0xG12;
    //   → Error [E001]: unexpected token
    //      ╭─▶ extended_literals.wyz:N:M
    //      │
    //      │   let bad = 0xG12;
    //      │              ╰ unexpected token `xG12`
    // ---------------------------------------------------------------
}
