fn main() {
    let byte_max: u8  = 0xFFu8;
    let short_val: u16 = 0x00FFu16;
    let dead_beef: u32 = 0xDEADBEEFu32;
    let big_hex: u64  = 0xCAFEBABEu64;

    std::io::println(byte_max);
    std::io::println(short_val);
    std::io::println(dead_beef);
    std::io::println(big_hex);

    let nibble: u8  = 0b1010u8;
    let byte_b: u8  = 0b11111111u8;
    let word_b: u16 = 0b1111000011110000u16;

    std::io::println(nibble);
    std::io::println(byte_b);
    std::io::println(word_b);

    let inferred_hex: u32 = 0xFF;
    let inferred_bin: u32 = 0b1010;
    let inferred_i32       = 0xFF;

    std::io::println(inferred_hex);
    std::io::println(inferred_bin);
    std::io::println(inferred_i32);

    let sum: u32  = 0xFF + 0b1010;
    let diff: u32 = 0xFFu32 - 0b1111u32;
    let prod: u32 = 0x10u32 * 0b11u32;

    std::io::println(sum);
    std::io::println(diff);
    std::io::println(prod);

    let and_result: u32 = 0xFF00u32 & 0x0FFFu32;
    let or_result:  u32 = 0xFF00u32 | 0x00FFu32;
    let shl_result: u32 = 0b0001u32 << 4;
    let shr_result: u32 = 0x80u32 >> 3;

    std::io::println(and_result);
    std::io::println(or_result);
    std::io::println(shl_result);
    std::io::println(shr_result);

    let status: u32 = 0xFF;
    match (status) {
        0x00 => std::io::println(0),
        0xFF => std::io::println(255),
        _    => std::io::println(1)
    };

    let flags: u8 = 0b1010u8;
    match (flags) {
        0b0000 => std::io::println(0),
        0b1010 => std::io::println(10),
        _      => std::io::println(99)
    };

    let neg_hex: i32 = -0x01;
    let neg_bin: i32 = -0b0001;

    std::io::println(neg_hex);
    std::io::println(neg_bin);

    let port: u32 = 0x1F90u32;
    std::io::println(f"Port number: {port}");
}
