generic<T> struct Wrapper {
  val: T
}

generic<T> fn unwrap_or_zero(w: generic<T> Wrapper, zero: T) -> T {
  return w.val;
}

fn main() {
  let w: generic<u32> Wrapper = generic<u32> Wrapper { val: 42u32 };
  let v: u32 = generic<u32> unwrap_or_zero(w, 0u32);
  
  let empty_arr: [u32] = [];
  let num_arr: [u32] = [1u32, 2u32, 3u32];

  // TODO: we need to print things to verify them, but we don't have println yet!
  // At least the compiler will typecheck it!
}
