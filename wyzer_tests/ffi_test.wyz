extern fn read_file(path: str@C) @ C -> str;
extern fn puts(s: str@C) @ C -> i32;
extern fn write_file(path: str@C, content: str@C) @ C -> i32;

fn main() -> u32 {
    // 1. Read file on C, transfer to Main
    let content: str@Main = transfer(read_file(transfer("test.txt", C)), Main);
    
    // 2. Transfer from Main back to C to write it
    let res: i32@C = write_file(transfer("test_out.txt", C), transfer(content, C));

    // 3. Transfer the result back to Main to print it!
    let res_main: i32@Main = transfer(res, Main);
    std::io::println(res_main);

    return 0;
}
