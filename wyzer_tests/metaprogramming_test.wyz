role @Client;

fn main() {
    // Cannot print integers yet because std::io::print is hardcoded to %s in codegen for V1
    // let size_u32 = sizeof<u32>() @Comptime;
    // let size_u64 = sizeof<u64>() @Comptime;
    
    let my_var = 42;
    // typeof is evaluated at compile time by the @Comptime context
    let type_name = typeof(my_var) @Comptime;
    
    std::io::println("Type of my_var:");
    std::io::println(type_name);
}
