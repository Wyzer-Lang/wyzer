(lang dune 3.24)
(name wyzer)
(sections (lib .) (libexec .) (bin ../../bin) (doc ../../doc/wyzer))
(files
 (lib
  (META
   dune-package
   lib/ast.ml
   lib/eval.ml
   lib/lexer.ml
   lib/parser.ml
   lib/parser.mli
   lib/perceus.ml
   lib/typechecker.ml
   lib/wyzer_lib.a
   lib/wyzer_lib.cma
   lib/wyzer_lib.cmi
   lib/wyzer_lib.cmt
   lib/wyzer_lib.cmx
   lib/wyzer_lib.cmxa
   lib/wyzer_lib.ml
   lib/wyzer_lib__Ast.cmi
   lib/wyzer_lib__Ast.cmt
   lib/wyzer_lib__Ast.cmx
   lib/wyzer_lib__Eval.cmi
   lib/wyzer_lib__Eval.cmt
   lib/wyzer_lib__Eval.cmx
   lib/wyzer_lib__Lexer.cmi
   lib/wyzer_lib__Lexer.cmt
   lib/wyzer_lib__Lexer.cmx
   lib/wyzer_lib__Parser.cmi
   lib/wyzer_lib__Parser.cmt
   lib/wyzer_lib__Parser.cmti
   lib/wyzer_lib__Parser.cmx
   lib/wyzer_lib__Perceus.cmi
   lib/wyzer_lib__Perceus.cmt
   lib/wyzer_lib__Perceus.cmx
   lib/wyzer_lib__Typechecker.cmi
   lib/wyzer_lib__Typechecker.cmt
   lib/wyzer_lib__Typechecker.cmx
   opam))
 (libexec (lib/wyzer_lib.cmxs))
 (bin (wyzerc))
 (doc (LICENSE README.md)))
(library
 (name wyzer.lib)
 (kind normal)
 (archives (byte lib/wyzer_lib.cma) (native lib/wyzer_lib.cmxa))
 (plugins (byte lib/wyzer_lib.cma) (native lib/wyzer_lib.cmxs))
 (native_archives lib/wyzer_lib.a)
 (requires ppx_deriving.std ppx_deriving.runtime)
 (main_module_name Wyzer_lib)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name wyzer_lib)
     (visibility public)
     (kind alias)
     (source (path Wyzer_lib) (impl (path lib/wyzer_lib.ml-gen))))
    (name Wyzer_lib)
    (modules
     (module
      (obj_name wyzer_lib__Ast)
      (visibility public)
      (source (path Ast) (impl (path lib/ast.ml))))
     (module
      (obj_name wyzer_lib__Eval)
      (visibility public)
      (source (path Eval) (impl (path lib/eval.ml))))
     (module
      (obj_name wyzer_lib__Lexer)
      (visibility public)
      (source (path Lexer) (impl (path lib/lexer.ml))))
     (module
      (obj_name wyzer_lib__Parser)
      (visibility public)
      (source
       (path Parser)
       (intf (path lib/parser.mli))
       (impl (path lib/parser.ml))))
     (module
      (obj_name wyzer_lib__Perceus)
      (visibility public)
      (source (path Perceus) (impl (path lib/perceus.ml))))
     (module
      (obj_name wyzer_lib__Typechecker)
      (visibility public)
      (source (path Typechecker) (impl (path lib/typechecker.ml))))))
   (wrapped true))))
